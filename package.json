{
  "name": "credoctor",
  "version": "0.1.0",
  "description": "Verify your per-directory credential domains \u2014 git identity, SSH keys, GPG signing, gh accounts \u2014 by making real calls instead of trusting config files.",
  "type": "module",
  "bin": {
    "credoctor": "dist/cli.js"
  },
  "files": [
    "dist",
    "gui",
    "README.md",
    "DESIGN.md",
    "ROADMAP.md",
    "LICENSE",
    "credoctor.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/cli.ts",
    "doctor": "npm run build --silent && node dist/cli.js doctor",
    "typecheck": "tsc --noEmit",
    "gui": "npm run build --silent && electron gui/main.cjs",
    "smoke": "npm run build --silent && node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && node scripts/smoke.mjs"
  },
  "keywords": [
    "git",
    "identity",
    "ssh",
    "gpg",
    "gh",
    "multi-account",
    "credentials"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^41.7.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlrSajjad/credoctor.git"
  },
  "homepage": "https://github.com/lvlrSajjad/credoctor#readme",
  "bugs": {
    "url": "https://github.com/lvlrSajjad/credoctor/issues"
  },
  "author": "Sadjad Asadi",
  "publishConfig": {
    "access": "public"
  }
}
